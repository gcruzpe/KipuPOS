@page "/cambiar-clave"
@inject AuthSession Auth
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Cambiar contraseña · KipuPOS</PageTitle>

<div class="screen">
    <PosHeader Where="@Auth.Current?.TenantName">
        <button type="button" class="btn btn-on-dark" @onclick="LogoutAsync">Salir</button>
    </PosHeader>
    <div class="center-page">
        <form class="center-card panel" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="panel-head" style="flex-direction: column; align-items: flex-start; gap: 4px">
                <h2>@(mustChange ? "Crea tu contraseña" : "Cambiar contraseña")</h2>
                <p class="muted" style="margin: 0; font-size: 15px">
                    @(mustChange ? "Es tu primer ingreso: reemplaza la contraseña temporal." : "Mínimo 8 caracteres.")
                </p>
            </div>
            <div class="tejido-2" aria-hidden="true"></div>
            <div class="panel-body">
                <div class="field">
                    <label for="cur">Contraseña actual</label>
                    <input id="cur" class="input" type="password" autocomplete="current-password" @bind="current" />
                </div>
                <div class="field">
                    <label for="new">Nueva contraseña</label>
                    <input id="new" class="input" type="password" autocomplete="new-password" @bind="next" />
                    <span class="hint">Mínimo 8 caracteres y distinta de la actual.</span>
                </div>
                <div class="field">
                    <label for="rep">Repite la nueva contraseña</label>
                    <input id="rep" class="input" type="password" autocomplete="new-password" @bind="repeat" />
                </div>
                @if (error is not null)
                {
                    <div class="alert" role="alert">@error</div>
                }
                <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@busy">
                    @(busy ? "Guardando…" : "Guardar y continuar")
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private string current = "", next = "", repeat = "";
    private string? error;
    private bool busy;
    private bool mustChange;

    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", replace: true); return; }
        mustChange = Auth.Current!.MustChangePassword;
    }

    private async Task SubmitAsync()
    {
        if (busy) return;
        error = null;
        if (next.Length < 8) { error = "La nueva contraseña debe tener al menos 8 caracteres."; return; }
        if (next != repeat) { error = "Las contraseñas nuevas no coinciden."; return; }
        if (next == current) { error = "La nueva contraseña debe ser distinta de la actual."; return; }

        busy = true;
        try
        {
            var res = await Api.PostAsync<LoginResponse>("api/auth/change-password", new ChangePasswordRequest(current, next));
            if (res is null) { error = "Respuesta vacía del servidor."; return; }
            await Auth.SetAsync(res); // token nuevo, ya sin la marca de cambio obligatorio
            Nav.NavigateTo(AppRoutes.HomeFor(res));
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/login");
    }
}
