@* Logo de quipu: un cordón principal y cordones colgantes con nudos *@
<span class="brand">
    <svg width="@Size" height="@Size" viewBox="0 0 40 40" fill="none" stroke-width="3" stroke-linecap="round" aria-hidden="true">
        <path d="M4 8h32" stroke="#F4ECE0"></path>
        <path d="M10 8v22" stroke="#E04B76"></path>
        <path d="M20 8v26" stroke="#E7B54A"></path>
        <path d="M30 8v16" stroke="#8DBA7F"></path>
        <circle cx="10" cy="17" r="2.5" stroke="#E04B76"></circle>
        <circle cx="20" cy="22" r="2.5" stroke="#E7B54A"></circle>
        <circle cx="20" cy="14" r="2.5" stroke="#E7B54A"></circle>
        <circle cx="30" cy="18" r="2.5" stroke="#8DBA7F"></circle>
    </svg>
    <span class="brand-word" style="font-size: @(WordSize)px">kipu<span>pos</span></span>
</span>

@code {
    [Parameter] public int Size { get; set; } = 34;
    [Parameter] public int WordSize { get; set; } = 26;
}
